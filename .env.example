# Supabase Postgres (pooled connection for the app, direct connection for migrations)
DATABASE_URL=
DIRECT_URL=

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Email (optional: without a key, emails are printed to the server console)
RESEND_API_KEY=
# Sender shown on emails. Resend only sends from a domain you have verified;
# the default below is Resend's test sender, which can only email your own account.
EMAIL_FROM="Brightloop <onboarding@resend.dev>"

# Protects the scheduled billing route
BILLING_CRON_SECRET=

# App base URL used in links
APP_URL=http://localhost:3000
