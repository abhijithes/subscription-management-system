generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  STAFF
  CUSTOMER
}

enum BillingPeriod {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum DiscountType {
  FIXED
  PERCENT
}

enum DiscountTarget {
  PRODUCT
  SUBSCRIPTION
}

enum SubscriptionStatus {
  DRAFT
  QUOTATION
  CONFIRMED
  ACTIVE
  CLOSED
}

enum InvoiceStatus {
  DRAFT
  CONFIRMED
  PAID
}

model User {
  id          String   @id @default(cuid())
  clerkUserId String   @unique
  email       String   @unique
  name        String
  company     String?
  address     String?
  role        Role     @default(CUSTOMER)
  createdAt   DateTime @default(now())

  subscriptions Subscription[]
  invoices      Invoice[]
  payments      Payment[]
}

model Product {
  id         String   @id @default(cuid())
  name       String
  type       String
  salesPrice Decimal  @db.Decimal(12, 2)
  costPrice  Decimal  @db.Decimal(12, 2)
  notes      String?
  createdAt  DateTime @default(now())

  variants          ProductVariant[]
  templateLines     TemplateLine[]
  subscriptionLines SubscriptionLine[]
  discountRules     DiscountRule[]
}

model ProductVariant {
  id         String  @id @default(cuid())
  productId  String
  attribute  String
  value      String
  extraPrice Decimal @default(0) @db.Decimal(12, 2)

  product           Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  templateLines     TemplateLine[]
  subscriptionLines SubscriptionLine[]

  @@index([productId])
}

model Plan {
  id              String        @id @default(cuid())
  name            String
  price           Decimal       @db.Decimal(12, 2)
  billingPeriod   BillingPeriod
  minQuantity     Int           @default(1)
  availableFrom   DateTime
  availableTo     DateTime
  autoClose       Boolean       @default(false)
  allowEarlyClose Boolean       @default(false)
  allowPause      Boolean       @default(false)
  allowRenew      Boolean       @default(false)
  createdAt       DateTime      @default(now())

  templates     QuotationTemplate[]
  subscriptions Subscription[]
}

model Tax {
  id          String  @id @default(cuid())
  name        String
  ratePercent Decimal @db.Decimal(5, 2)

  subscriptionLines SubscriptionLine[]
}

model DiscountRule {
  id          String         @id @default(cuid())
  name        String
  type        DiscountType
  value       Decimal        @db.Decimal(12, 2)
  minPurchase Decimal?       @db.Decimal(12, 2)
  minQuantity Int?
  startsAt    DateTime
  endsAt      DateTime
  usageLimit  Int
  usedCount   Int            @default(0)
  appliesTo   DiscountTarget
  productId   String?

  product  Product?          @relation(fields: [productId], references: [id])
  invoices InvoiceDiscount[]
}

model QuotationTemplate {
  id           String   @id @default(cuid())
  name         String
  planId       String
  validityDays Int
  createdAt    DateTime @default(now())

  plan  Plan           @relation(fields: [planId], references: [id])
  lines TemplateLine[]
}

model TemplateLine {
  id         String  @id @default(cuid())
  templateId String
  productId  String
  variantId  String?
  quantity   Int

  template QuotationTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  product  Product           @relation(fields: [productId], references: [id])
  variant  ProductVariant?   @relation(fields: [variantId], references: [id])

  @@index([templateId])
}

model Subscription {
  id                 String             @id @default(cuid())
  number             String             @unique
  customerId         String
  planId             String
  status             SubscriptionStatus @default(DRAFT)
  isPaused           Boolean            @default(false)
  pausedAt           DateTime?
  startDate          DateTime
  expiryDate         DateTime
  paymentTermsDays   Int
  nextBillingDate    DateTime?
  quotationExpiresAt DateTime?
  createdAt          DateTime           @default(now())

  customer User               @relation(fields: [customerId], references: [id])
  plan     Plan               @relation(fields: [planId], references: [id])
  lines    SubscriptionLine[]
  invoices Invoice[]

  @@index([status])
  @@index([nextBillingDate])
  @@index([customerId])
}

model SubscriptionLine {
  id             String  @id @default(cuid())
  subscriptionId String
  productId      String
  variantId      String?
  quantity       Int
  unitPrice      Decimal @db.Decimal(12, 2)
  taxId          String?

  subscription Subscription    @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  product      Product         @relation(fields: [productId], references: [id])
  variant      ProductVariant? @relation(fields: [variantId], references: [id])
  tax          Tax?            @relation(fields: [taxId], references: [id])

  @@index([subscriptionId])
}

model Invoice {
  id             String        @id @default(cuid())
  number         String        @unique
  subscriptionId String
  customerId     String
  periodStart    DateTime
  periodEnd      DateTime
  revision       Int           @default(1)
  status         InvoiceStatus @default(DRAFT)
  invoiceDate    DateTime
  dueDate        DateTime
  subtotal       Decimal       @db.Decimal(12, 2)
  discountTotal  Decimal       @db.Decimal(12, 2)
  taxTotal       Decimal       @db.Decimal(12, 2)
  total          Decimal       @db.Decimal(12, 2)
  createdAt      DateTime      @default(now())

  subscription Subscription      @relation(fields: [subscriptionId], references: [id])
  customer     User              @relation(fields: [customerId], references: [id])
  lines        InvoiceLine[]
  discounts    InvoiceDiscount[]
  payments     Payment[]

  @@unique([subscriptionId, periodStart, revision])
  @@index([status])
  @@index([dueDate])
  @@index([customerId])
}

model InvoiceLine {
  id             String  @id @default(cuid())
  invoiceId      String
  description    String
  quantity       Int
  unitPrice      Decimal @db.Decimal(12, 2)
  taxName        String?
  taxRatePercent Decimal @default(0) @db.Decimal(5, 2)
  discount       Decimal @default(0) @db.Decimal(12, 2)
  amount         Decimal @db.Decimal(12, 2)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model InvoiceDiscount {
  id             String @id @default(cuid())
  invoiceId      String
  discountRuleId String

  invoice      Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  discountRule DiscountRule @relation(fields: [discountRuleId], references: [id])

  @@unique([invoiceId, discountRuleId])
}

model Payment {
  id           String   @id @default(cuid())
  invoiceId    String
  method       String
  amount       Decimal  @db.Decimal(12, 2)
  paidAt       DateTime
  note         String?
  recordedById String

  invoice    Invoice @relation(fields: [invoiceId], references: [id])
  recordedBy User    @relation(fields: [recordedById], references: [id])

  @@index([invoiceId])
  @@index([paidAt])
}
